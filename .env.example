NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated exact origins; empty denies browser cross-origin access.
CORS_ORIGINS=
JSON_BODY_LIMIT_BYTES=102400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
# No database or authentication secrets are needed until later phases.
