NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated exact origins; empty denies browser cross-origin access.
CORS_ORIGINS=
JSON_BODY_LIMIT_BYTES=102400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
# Run npm run env:local to generate private credentials into a NEW .env.
# These placeholders must not be used as credentials.
POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD=replace-with-generated-bootstrap-password
CLU_DEV_PASSWORD=replace-with-generated-development-password
CLU_TEST_PASSWORD=replace-with-separate-generated-test-password
DATABASE_URL=postgresql://clu_dev:replace-with-generated-development-password@localhost:5433/clu_store_dev
TEST_DATABASE_URL=postgresql://clu_test:replace-with-separate-generated-test-password@localhost:5433/clu_store_test
DB_CHECK_TIMEOUT_MS=2000
