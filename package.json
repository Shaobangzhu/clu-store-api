{
  "name": "clu-store-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc",
    "env:local": "node --import tsx scripts/setup-local-env.ts",
    "prepare": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "node --env-file=.env --import tsx scripts/migrate-test.ts",
    "db:smoke": "node --env-file=.env --import tsx scripts/db-smoke.ts",
    "db:readiness:smoke": "node --env-file=.env --import tsx scripts/readiness-smoke.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:seed:verify": "node --env-file=.env --import tsx scripts/seed-verify.ts",
    "fixtures:curate": "node --import tsx scripts/curate-frontend.ts",
    "fixtures:curate:samples": "node --import tsx scripts/curate-samples.ts",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "6.0.3",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
