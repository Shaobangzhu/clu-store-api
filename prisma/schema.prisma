generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CartStatus {
  ACTIVE
}

enum OrderStatus {
  pending
  approved
  rejected
}

enum Currency {
  CNY
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  username      String               @unique @db.VarChar(100)
  email         String               @unique @db.VarChar(254)
  passwordHash  String
  role          Role                 @default(USER)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  cart          Cart?
  orders        Order[]
  statusHistory OrderStatusHistory[]
}

model Category {
  id                Int       @id @default(autoincrement())
  title             String    @unique
  slug              String    @unique
  subTitle          String?
  videos            Json?
  editorialFeatures Json?
  products          Product[]
}

model Product {
  id             Int                 @id @default(autoincrement())
  categoryId     Int?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name           String
  title          String
  imageSrc       String
  carouselImages Json
  startingPrice  Decimal             @db.Decimal(12, 2)
  installments   Decimal?            @db.Decimal(12, 2)
  features       Json
  inStock        Boolean             @default(false)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  models         ProductModel[]
  memorySizes    ProductMemorySize[]
  colors         ProductColor[]
  offers         Offer[]
  newArrivals    NewArrival[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([name])
  @@index([createdAt, id])
}

model ProductModel {
  id            Int        @id @default(autoincrement())
  productId     Int
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name          String
  specification String
  price         Decimal    @db.Decimal(12, 2)
  inStock       Boolean    @default(false)
  cartItems     CartItem[]

  @@unique([productId, id])
}

model ProductMemorySize {
  id         Int        @id @default(autoincrement())
  productId  Int
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name       String
  extraPrice Decimal    @db.Decimal(12, 2)
  inStock    Boolean    @default(false)
  cartItems  CartItem[]

  @@unique([productId, id])
}

model ProductColor {
  id        Int        @id @default(autoincrement())
  productId Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name      String
  inStock   Boolean    @default(false)
  cartItems CartItem[]

  @@unique([productId, name])
}

model Offer {
  id        Int       @id @default(autoincrement())
  productId Int?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  type      String
  title     String
  detail    String
  imageSrc  String
  startsAt  DateTime? @db.Timestamptz(3)
  endsAt    DateTime? @db.Timestamptz(3)
  active    Boolean   @default(false)
  soldOut   Boolean   @default(false)

  @@index([productId])
  @@index([active, startsAt, endsAt])
}

model NewArrival {
  id           Int      @id @default(autoincrement())
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  displayOrder Int
  title        String
  detail       String
  imageSrc     String
  textColor    String
  soldOut      Boolean  @default(false)

  @@index([productId])
  @@index([displayOrder, id])
}

model SupportInformation {
  key       String
  locale    String
  html      String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([key, locale])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status    CartStatus @default(ACTIVE)
  currency  Currency   @default(CNY)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  items     CartItem[]
}

model CartItem {
  id           Int               @id @default(autoincrement())
  cartId       Int
  cart         Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId    Int
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  modelId      Int
  model        ProductModel      @relation(fields: [productId, modelId], references: [productId, id], onDelete: Restrict, onUpdate: Cascade)
  memorySizeId Int
  memorySize   ProductMemorySize @relation(fields: [productId, memorySizeId], references: [productId, id], onDelete: Restrict, onUpdate: Cascade)
  color        String
  productColor ProductColor      @relation(fields: [productId, color], references: [productId, name], onDelete: Restrict, onUpdate: Cascade)
  quantity     Int
  unitPrice    Decimal           @db.Decimal(12, 2)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([cartId, productId, modelId, memorySizeId, color])
  @@index([productId, modelId])
  @@index([productId, memorySizeId])
  @@index([productId, color])
}

model Order {
  id                 Int                  @id @default(autoincrement())
  userId             String               @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status             OrderStatus          @default(pending)
  totalAmount        Decimal              @db.Decimal(12, 2)
  currency           Currency             @default(CNY)
  idempotencyKey     String?              @db.VarChar(128)
  requestFingerprint String?              @db.VarChar(64)
  metadata           Json?
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([createdAt, id])
  @@index([status, createdAt])
}

model OrderItem {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId          Int?
  product            Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productName        String
  modelName          String
  modelSpecification String
  memoryName         String
  color              String
  unitPrice          Decimal  @db.Decimal(12, 2)
  quantity           Int
  lineTotal          Decimal  @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  operatorId String       @db.Uuid
  operator   User         @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  metadata   Json?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt, id])
  @@index([operatorId])
}
